  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "BAKAL\xC1\u0158SK\xC1 PR\xC1CE\nPorovn\xE1v\xE1m dva zp\u016Fsoby ovl\xE1d\xE1n\xED
    v mixed reality: menu ovl\xE1dan\xE9 rukou a zad\xE1v\xE1n\xED hlasem. Pt\xE1m
    se, kter\xFD z nich nech\xE1 \u010Dlov\u011Bku v\xEDc kapacity na pr\xE1ci samotnou.\n\nHLAVN\xCD
    \xDALOHA\nSestavit strukturu podle p\u0159edlohy. Objekt si nejd\u0159\xEDv zad\xE1\u0161
    (barvu, tvar, u jednoho bloku i velikost) a pak ho polo\u017E\xED\u0161 na vyzna\u010Den\xE9
    m\xEDsto.\n\nSOUB\u011A\u017DN\xC1 \xDALOHA\nB\u011Bhem stavby se rozsv\u011Bcuj\xED
    ter\u010De. Nejsou tam pro z\xE1bavu: m\u011B\u0159\xED, kolik pozornosti a rukou
    ti ovl\xE1d\xE1n\xED nech\xE1v\xE1 voln\xFDch.\n\nCO SE M\u011A\u0158\xCD\n\u010Cas
    a p\u0159esnost stavby, kolik ter\u010D\u016F stihne\u0161 a jak rychle. Kl\xED\u010Dov\xFD
    je rozd\xEDl mezi t\xEDm, jak si vede\u0161 u jedn\xE9 \xFAlohy a jak p\u0159i
    obou z\xE1rove\u0148."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
