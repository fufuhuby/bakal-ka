# Crash logs
mono_crash.*.json

# Large purchased assets (reimport from Asset Store)
Assets/PrefabsVRT/

# OS files
.DS_Store
Thumbs.db


# Testovaci snimky z ladeni - pojmenovane rendery zustavaji
Assets/Screenshots/screenshot-*.png
Assets/Screenshots/screenshot-*.png.meta

# Cache Unity AI nastroju (per-uzivatel, nic spolecneho s projektem)
UserSettings/AI.*/
UserSettings/Layouts/CurrentMaximizeLayout.dwlt
